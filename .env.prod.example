# Phase 13: mẫu .env cho VPS. Trên VPS: cp .env.prod.example .env && nano .env && chmod 600 .env
# KHÔNG commit file .env thật. Mọi giá trị bí mật để trống ở đây, điền trên VPS.
# Tạo chuỗi ngẫu nhiên:  python3 -c "import secrets; print(secrets.token_hex(32))"

# ---- Docker Compose ----
# Nhờ dòng này, trên VPS chỉ cần gõ `docker compose up -d` (không cần -f docker-compose.prod.yml)
COMPOSE_FILE=docker-compose.prod.yml
# Tên miền đã trỏ A record về IP của VPS, và email nhận thông báo của Let's Encrypt
DOMAIN=
ACME_EMAIL=

# ---- App ----
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=https://THAY_BANG_DOMAIN
EXPOSE_API_DOCS=false

# ---- PostgreSQL ----
POSTGRES_USER=rag
# Chỉ dùng chữ + số (token_hex): ký tự như @ : / làm hỏng DATABASE_URL
POSTGRES_PASSWORD=
POSTGRES_DB=ragdb
# Cùng mật khẩu với POSTGRES_PASSWORD; host là "postgres" (tên service), không phải localhost
DATABASE_URL=postgresql+psycopg://rag:THAY_BANG_POSTGRES_PASSWORD@postgres:5432/ragdb

# ---- Provider ----
# CHÉP NGUYÊN khối provider/retrieval từ .env ở máy bạn (đã chạy tốt, ngưỡng đã tune), rồi điền key.
# Đừng để dòng nào kiểu "EMBEDDING_MODEL=" trống: trống = chuỗi rỗng, KHÔNG phải giá trị mặc định.
# Embedding PHẢI giống hệt lúc bạn tạo vector (cùng model, 1536 chiều), nếu không phải reembed_all.
# Ví dụ theo cấu hình hiện tại của bạn, bỏ dấu # và sửa theo .env thật:
# EMBEDDING_PROVIDER=cohere
# COHERE_EMBEDDING_MODEL=embed-v4.0
# RETRIEVAL_MODE=hybrid
# KEYWORD_RANKING=pg_textsearch
# RERANKER_PROVIDER=cohere
# COHERE_RERANK_MODEL=rerank-v4.0-pro
# RERANKER_MIN_SCORE=0.70
# COHERE_EMBED_API_KEY=
# COHERE_RERANK_API_KEY=
# LLM_PROVIDER=openrouter
# LLM_MODEL=
# OPENROUTER_ANSWER_API_KEY=
# ANSWER_PROMPT=v5
GROUNDING_CHECK=false
QUERY_REWRITE=off
PROVIDER_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180

# ---- Bảo mật (Phase 12b-12d) ----
AUTH_ENABLED=true
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
# Để trống: chỉ quản trị bằng tài khoản superadmin (tạo bằng scripts/manage_users.py)
ADMIN_API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=200
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
# true: backend đứng sau Caddy, và Caddy ghi IP thật vào X-Forwarded-For
TRUST_FORWARDED_FOR=true
METRICS_TOKEN=

# ---- Hiệu năng (Phase 12a, 12c) ----
BACKGROUND_INGESTION=true
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=86400
EMBEDDING_CACHE_SIZE=1000
CHAT_CONDENSE_QUESTION=true
