APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://rag:change_me@postgres:5432/ragdb

BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- LLM (Phase 6): OpenRouter ----
# # gemini | openrouter | fake
# LLM_PROVIDER=openrouter
# # Model trả lời (đọc CV): chọn model có host không lưu/không train trên prompt
# LLM_MODEL=qwen/qwen3.8-27b:free
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=4096
# CONTEXT_MAX_CHARS=6000

LLM_PROVIDER=groq
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
CONTEXT_MAX_CHARS=6000

ANSWER_PROMPT=v4
# Groq: key cho phần trả lời
GROQ_API_KEY=

# Key chung: dùng khi một key riêng bên dưới để trống
OPENROUTER_API_KEY=
# 3 key theo vai trò, tạo cả 3 trong CÙNG 1 tài khoản
# answer = chatbot trả lời + viết lại câu hỏi nối tiếp
OPENROUTER_ANSWER_API_KEY=
# grounding = kiểm tra grounding (khi GROUNDING_CHECK=true)
OPENROUTER_GROUNDING_API_KEY=
# judge = giám khảo faithfulness khi chạy eval
OPENROUTER_JUDGE_API_KEY=

# ---- Citation + Grounding (Phase 7) + giám khảo faithfulness (Phase 11) ----
# true = mỗi câu gọi LLM thêm 1 lần. Để false khi dùng free tier
GROUNDING_CHECK=false
# Model kiểm tra grounding khi chatbot chạy thật (đọc CV nếu bật GROUNDING_CHECK).
# Host "may train on prompts" thì đừng bật GROUNDING_CHECK với app CV
GROUNDING_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Giám khảo faithfulness khi chạy eval. Chỉ chấm dữ liệu công khai (SQuAD/ViQuAD)
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Để comment = dùng mặc định theo RERANKER_PROVIDER (gemini 0.4, cohere 0.1). 
# Bỏ comment và điền số sau khi chạy scripts/tune_threshold.py 
# RERANKER_MIN_SCORE=0.4 

EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=

# vector | keyword | hybrid. Kết quả eval (2026-11): vector -> rerank tốt nhất cho paper mode
RETRIEVAL_MODE=vector
# ts_rank | bm25 | pg_textsearch (cần Postgres 17 + migration 0006)
KEYWORD_RANKING=pg_textsearch
RETRIEVAL_CANDIDATE_K = 30
RRF_K = 60
RRF_KEYWORD_WEIGHT=1.0
RETRIEVAL_TOP_K=20

# gemini | cohere | none (giữ nguyên thứ tự retrieval) | fake (test) 
RERANKER_PROVIDER=cohere

# Kiểm tra tên model còn hiệu lực trong Google AI Studio 
RERANKER_MODEL=gemini-3.5-flash-lite 
RERANKER_TOP_K=5 
RERANKER_MAX_CHARS=1000 

# Dùng khi RERANKER_PROVIDER=cohere 
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# ---- Chunking (Phase 2) — đơn vị: TOKEN ----
CHUNK_SIZE=256
CHUNK_OVERLAP=40
TOKENIZER_ENCODING=o200k_base

FRONTEND_PORT=3000

# Phase 9: API
ADMIN_API_KEY=
CHAT_CONDENSE_QUESTION=true
CHAT_HISTORY_TURNS=3

# ---- Xử lý nền + timeout (Phase 12a) ----
# true = upload trả 202 ngay, service worker xử lý sau. false = xử lý ngay trong request (như cũ)
BACKGROUND_INGESTION=true
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=900
WORKER_STALE_AFTER_SECONDS=900
# Tối đa 1 lần gọi embedding/rerank, và 1 lần gọi LLM (giây)
PROVIDER_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180


# ---- Đăng nhập + phân quyền (Phase 12b) ----
# false = như Phase 9 (chat không cần đăng nhập, quản trị bằng X-API-Key)
AUTH_ENABLED=false
# Bắt buộc khi AUTH_ENABLED=true, >= 32 ký tự. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60


# ---- Rate limiting + cache (Phase 12c) ----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=200
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
# true CHỈ KHI backend đứng sau reverse proxy của bạn (nginx, Caddy, Cloudflare...)
TRUST_FORWARDED_FOR=false
# Cache câu trả lời: khoá gồm app + câu hỏi + danh sách paper (paper mode) + tài liệu READY + cấu hình
# TẮT khi chạy đánh giá (eval) để mọi câu đều gọi AI thật
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL_SECONDS=86400
EMBEDDING_CACHE_SIZE=1000

# ---- Logging + monitoring (Phase 12d) ----
# text (dễ đọc khi dev) | json (production)
LOG_FORMAT=text
# Bắt buộc để Prometheus đọc /metrics khi APP_ENV khác development
METRICS_TOKEN=
# Để trống = /docs chỉ bật khi APP_ENV=development
EXPOSE_API_DOCS=
